{
  "info": {
    "_postman_id": "ecobite-qa-api-inicial",
    "name": "EcoBite API - QA Inicial",
    "description": "Pruebas iniciales de API del backend EcoBite. Variable base_url: cambiá a la URL remota que pase Backend cuando haya una.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "00 Health Check - GET /",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200', () => pm.response.to.have.status(200));",
              "pm.test('El servidor responde JSON', () => pm.response.to.be.json);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
      }
    },
    {
      "name": "TC-API-001 Registro cliente SIN email (espera 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 400 (no 500)', () => pm.response.to.have.status(400));",
              "pm.test('Devuelve error claro en JSON', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body, 'el body debe tener campo error').to.have.property('error');",
              "    pm.expect(body.error).to.be.a('string').and.to.not.be.empty;",
              "});",
              "pm.test('Mensaje: Faltan datos obligatorios', () => {",
              "    pm.expect(pm.response.json().error).to.eql('Faltan datos obligatorios');",
              "});",
              "pm.test('NO es error 500 (caida del servidor)', () => {",
              "    pm.expect(pm.response.code).to.not.eql(500);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contrasena\": \"Secret123!\",\n  \"canal_adquisicion\": \"instagram\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/usuario/registro-cliente",
          "host": ["{{base_url}}"],
          "path": ["api", "usuario", "registro-cliente"]
        }
      }
    },
    {
      "name": "TC-API-002 Registro cliente SIN contraseña (espera 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 400', () => pm.response.to.have.status(400));",
              "pm.test('Mensaje: Faltan datos obligatorios', () => {",
              "    pm.expect(pm.response.json().error).to.eql('Faltan datos obligatorios');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"qa.sinpass@ecobite.test\",\n  \"canal_adquisicion\": \"instagram\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/usuario/registro-cliente",
          "host": ["{{base_url}}"],
          "path": ["api", "usuario", "registro-cliente"]
        }
      }
    },
    {
      "name": "TC-API-003 Registro cliente body vacío (espera 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 400', () => pm.response.to.have.status(400));",
              "pm.test('Devuelve error legible', () => {",
              "    pm.expect(pm.response.json().error).to.eql('Faltan datos obligatorios');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{base_url}}/api/usuario/registro-cliente",
          "host": ["{{base_url}}"],
          "path": ["api", "usuario", "registro-cliente"]
        }
      }
    },
    {
      "name": "TC-API-004 Registro cliente datos válidos (espera 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 201', () => pm.response.to.have.status(201));",
              "pm.test('No expone la contraseña en la respuesta', () => {",
              "    const body = JSON.stringify(pm.response.json());",
              "    pm.expect(body).to.not.include('Secret123!');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"qa.happy@ecobite.test\",\n  \"contrasena\": \"Secret123!\",\n  \"canal_adquisicion\": \"instagram\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/usuario/registro-cliente",
          "host": ["{{base_url}}"],
          "path": ["api", "usuario", "registro-cliente"]
        }
      }
    },
    {
      "name": "TC-API-005 Registro cliente sin JSON Content-Type (regresión)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('No devuelve 500', () => pm.response.to.not.have.status(500));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "body": {
          "mode": "raw",
          "raw": "email=foo@bar.com"
        },
        "url": {
          "raw": "{{base_url}}/api/usuario/registro-cliente",
          "host": ["{{base_url}}"],
          "path": ["api", "usuario", "registro-cliente"]
        }
      }
    }
  ]
}
